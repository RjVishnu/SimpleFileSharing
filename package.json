{
  "name": "file-server-app",
  "version": "2.0.0",
  "description": "Advanced File Server with Preview and Navigation",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node build.js",
    "build-exe": "pkg . --target node18-win32-x64 --output ./dist/FileServer.exe",
    "build-linux": "node build-linux.js",
    "build-all": "node build-all.js",
    "test": "node test/smoke.js && node test/thumbs.js"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "src/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "config.js",
      "app-config.json"
    ],
    "targets": [
      "node18-win32-x64"
    ],
    "outputPath": "./dist"
  },
  "dependencies": {
    "archiver": "^5.3.1",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "author": "Your Name",
  "license": "MIT",
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
